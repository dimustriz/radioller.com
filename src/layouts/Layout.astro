---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLangFromUrl, t, localePath, locales, localeNames } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(de|ru|uk|es|it|fr)/, '') || '/';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Radioller';
const metaTitle = title ? `${title} \u2014 ${siteName}` : `${siteName} \u2014 Your Internet Radio Anywhere`;
const metaDescription = description || i.hero.subtitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="icon" type="image/svg+xml" href="/ic_icon.svg" />
  <link rel="canonical" href={canonicalURL.href} />

  {locales.map((loc) => (
    <link rel="alternate" hreflang={loc} href={new URL(localePath(loc, pathWithoutLang), Astro.site).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(pathWithoutLang, Astro.site).href} />

  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

    :root {
      --bg: #1a1412;
      --bg-card: #241e1a;
      --bg-card-hover: #2e2620;
      --text: #f5ebe0;
      --text-muted: #b8a99a;
      --accent: #f59e0b;
      --accent-hover: #d97706;
      --accent-glow: rgba(245, 158, 11, 0.12);
      --border: #3d3028;
      --gradient-start: #f59e0b;
      --gradient-end: #ef4444;
      --header-bg: rgba(26, 20, 18, 0.88);
      --quote-bg: rgba(245, 158, 11, 0.06);
    }

    :root.light {
      --bg: #fffbf5;
      --bg-card: #fff7ed;
      --bg-card-hover: #ffedd5;
      --text: #292524;
      --text-muted: #78716c;
      --accent: #ea580c;
      --accent-hover: #c2410c;
      --accent-glow: rgba(234, 88, 12, 0.08);
      --border: #fed7aa;
      --gradient-start: #ea580c;
      --gradient-end: #dc2626;
      --header-bg: rgba(255, 251, 245, 0.88);
      --quote-bg: rgba(234, 88, 12, 0.05);
    }

    @media (prefers-color-scheme: light) {
      :root:not(.dark) {
        --bg: #fffbf5;
        --bg-card: #fff7ed;
        --bg-card-hover: #ffedd5;
        --text: #292524;
        --text-muted: #78716c;
        --accent: #ea580c;
        --accent-hover: #c2410c;
        --accent-glow: rgba(234, 88, 12, 0.08);
        --border: #fed7aa;
        --gradient-start: #ea580c;
        --gradient-end: #dc2626;
        --header-bg: rgba(255, 251, 245, 0.88);
        --quote-bg: rgba(234, 88, 12, 0.05);
      }
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      min-height: 100vh;
      overflow-x: hidden;
    }

    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 100;
      background: var(--header-bg);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      transition: transform 0.3s ease;
    }

    header.header-hidden {
      transform: translateY(-100%);
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--text); }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.4rem;
      cursor: pointer;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      margin-left: 0.5rem;
    }

    .theme-toggle:hover {
      color: var(--text);
      border-color: var(--accent);
    }

    .theme-toggle svg {
      width: 18px;
      height: 18px;
    }

    .theme-toggle .icon-sun { display: none; }
    .theme-toggle .icon-moon { display: block; }
    :root.light .theme-toggle .icon-sun { display: block; }
    :root.light .theme-toggle .icon-moon { display: none; }
    @media (prefers-color-scheme: light) {
      :root:not(.dark) .theme-toggle .icon-sun { display: block; }
      :root:not(.dark) .theme-toggle .icon-moon { display: none; }
    }

    main {
      padding-top: 64px;
    }

    footer {
      text-align: center;
      padding: 3rem 2rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    footer p:first-child {
      font-size: 1.1rem;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    .footer-link {
      color: var(--accent);
      text-decoration: none;
    }

    .footer-link:hover {
      text-decoration: underline;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 0.75rem;
    }

    :global(.container) {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    @media (max-width: 768px) {
      .header-inner {
        padding: 0 1rem;
      }

      nav {
        gap: 0.8rem;
      }

      nav a {
        font-size: 0.85rem;
      }
    }

    @media (max-width: 480px) {
      .logo span { display: none; }

      nav {
        gap: 0.5rem;
      }
    }
  </style>
  <script>
    // Sync language with Blazor app via shared localStorage['lang']
    (function () {
      const stored = localStorage.getItem('lang');
      if (!stored) return;
      const match = location.pathname.match(/^\/(de|fr|es|it|ru|uk)(\/|$)/);
      const urlLang = match ? match[1] : 'en';
      if (stored === urlLang) return;
      const rest = location.pathname.replace(/^\/(de|fr|es|it|ru|uk)/, '') || '/';
      location.replace(stored === 'en' ? (rest || '/') : `/${stored}${rest}`);
    })();
  </script>
</head>
<body>
  <header>
    <div class="header-inner">
      <a href={localePath(lang, '/')} class="logo">
        <img src="/ic_icon.svg" alt="Radioller" class="logo-icon" />
        <span>Radioller</span>
      </a>
      <nav>
        <a href={localePath(lang, '/')}>{i.nav.home}</a>
        <a href={localePath(lang, '/privacy')}>{i.nav.privacy}</a>
        <a href={localePath(lang, '/contact')}>{i.nav.contact}</a>
        <LanguageSwitcher />
        <button class="theme-toggle" aria-label="Toggle theme">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <p>{i.footer.tagline}</p>
    <div class="footer-links">
      <a href={localePath(lang, '/donate')} class="footer-link">{i.nav.donate}</a>
      <a href={localePath(lang, '/terms')} class="footer-link">{i.nav.terms}</a>
      <a href={localePath(lang, '/refunds')} class="footer-link">{i.nav.refunds}</a>
      <a href={localePath(lang, '/privacy')} class="footer-link">{i.nav.privacy}</a>
      <a href={localePath(lang, '/deletion')} class="footer-link">{i.nav.deletion}</a>
      <a href={localePath(lang, '/contact')} class="footer-link">{i.nav.contact}</a>
    </div>
    <p>&copy; {new Date().getFullYear()} <a href="https://fodylabs.com" target="_blank" rel="noopener" class="footer-link">Fody Labs</a>. {i.footer.copyright}</p>
  </footer>

  <script>
    const toggle = document.querySelector('.theme-toggle');
    const root = document.documentElement;
    const stored = localStorage.getItem('theme');
    if (stored === 'light') root.classList.add('light');
    else if (stored === 'dark') root.classList.add('dark');
    toggle?.addEventListener('click', () => {
      const isLight = root.classList.contains('light') ||
        (!root.classList.contains('dark') && window.matchMedia('(prefers-color-scheme: light)').matches);
      if (isLight) {
        root.classList.remove('light');
        root.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        root.classList.remove('dark');
        root.classList.add('light');
        localStorage.setItem('theme', 'light');
      }
    });

    // Hide header on scroll down, show on scroll up
    (() => {
      const header = document.querySelector('header');
      let lastY = window.scrollY;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (y > lastY && y > 64) {
          header?.classList.add('header-hidden');
        } else {
          header?.classList.remove('header-hidden');
        }
        lastY = y;
      }, { passive: true });
    })();
  </script>
  <script is:inline src="https://chat.fodylabs.com/chat-engine.js" defer></script>
  <script is:inline>
    window.addEventListener('load', function () {
      if (!window.ChatEngine) return;
      const chatLocale = (navigator.language || 'en').split('-')[0].toLowerCase();
      const nudgeText = {
        en: 'Looking for a station? Ask me and listen right here.',
        de: 'Auf der Suche nach einem Sender? Frag mich und hör direkt hier.',
        ru: 'Ищете станцию? Спросите меня и слушайте прямо здесь.',
        uk: 'Шукаєте станцію? Запитайте мене і слухайте просто тут.',
        es: '¿Buscas una emisora? Pregúntame y escúchala aquí mismo.',
        it: 'Cerchi una stazione? Chiedimi e ascoltala qui.',
        fr: 'Vous cherchez une station ? Demandez-moi et écoutez ici même.',
        pl: 'Szukasz stacji? Zapytaj mnie i słuchaj tutaj.'
      };
      window.radiollerChat = window.ChatEngine.mount({
        endpoint: 'https://chat.fodylabs.com/api/chat',
        historyEndpoint: 'https://chat.fodylabs.com/api/history',
        title: 'Radioller AI',
        greeting: 'Hi! Tell me what kind of radio station you are looking for.',
        placeholder: 'Find a station by name or genre…',
        nudge: nudgeText[chatLocale] || nudgeText.en,
        theme: {
          light: { '--chat-primary': '#ea580c' },
          dark: { '--chat-primary': '#f59e0b' }
        },
        onBotMessageRendered: function (bubble) {
          const playerLabels = {
            en: { loading: 'Loading player…', unavailable: 'Station player is unavailable.', noStream: 'This station does not provide a playable stream.', openApp: 'Listen in the Radioller app', play: 'Play', pause: 'Pause', mute: 'Mute', unmute: 'Unmute', volume: 'Volume', live: 'Live', buffering: 'Buffering…' },
            de: { loading: 'Player wird geladen…', unavailable: 'Der Sender-Player ist nicht verfügbar.', noStream: 'Für diesen Sender ist kein abspielbarer Stream verfügbar.', openApp: 'In der Radioller-App hören', play: 'Abspielen', pause: 'Pause', mute: 'Stummschalten', unmute: 'Ton an', volume: 'Lautstärke', live: 'Live', buffering: 'Puffern…' },
            ru: { loading: 'Загружаем плеер…', unavailable: 'Плеер станции недоступен.', noStream: 'Для этой станции нет доступного потока.', openApp: 'Слушать в приложении Radioller', play: 'Слушать', pause: 'Пауза', mute: 'Выключить звук', unmute: 'Включить звук', volume: 'Громкость', live: 'Эфир', buffering: 'Буферизация…' },
            uk: { loading: 'Завантажуємо плеєр…', unavailable: 'Плеєр станції недоступний.', noStream: 'Для цієї станції немає доступного потоку.', openApp: 'Слухати в застосунку Radioller', play: 'Слухати', pause: 'Пауза', mute: 'Вимкнути звук', unmute: 'Увімкнути звук', volume: 'Гучність', live: 'Ефір', buffering: 'Буферизація…' },
            es: { loading: 'Cargando reproductor…', unavailable: 'El reproductor no está disponible.', noStream: 'Esta emisora no tiene una transmisión reproducible.', openApp: 'Escuchar en la app Radioller', play: 'Reproducir', pause: 'Pausar', mute: 'Silenciar', unmute: 'Activar sonido', volume: 'Volumen', live: 'En vivo', buffering: 'Cargando…' },
            it: { loading: 'Caricamento del player…', unavailable: 'Il player della stazione non è disponibile.', noStream: 'Questa stazione non offre uno streaming riproducibile.', openApp: 'Ascolta nell’app Radioller', play: 'Riproduci', pause: 'Pausa', mute: 'Disattiva audio', unmute: 'Attiva audio', volume: 'Volume', live: 'In diretta', buffering: 'Caricamento…' },
            fr: { loading: 'Chargement du lecteur…', unavailable: 'Le lecteur de la station est indisponible.', noStream: 'Cette station ne propose pas de flux lisible.', openApp: 'Écouter dans l’application Radioller', play: 'Écouter', pause: 'Pause', mute: 'Couper le son', unmute: 'Activer le son', volume: 'Volume', live: 'En direct', buffering: 'Mise en mémoire…' },
            pl: { loading: 'Ładowanie odtwarzacza…', unavailable: 'Odtwarzacz stacji jest niedostępny.', noStream: 'Ta stacja nie udostępnia odtwarzalnego strumienia.', openApp: 'Słuchaj w aplikacji Radioller', play: 'Słuchaj', pause: 'Pauza', mute: 'Wycisz', unmute: 'Włącz dźwięk', volume: 'Głośność', live: 'Na żywo', buffering: 'Buforowanie…' }
          };
          const labels = playerLabels[(navigator.language || 'en').split('-')[0].toLowerCase()] || playerLabels.en;
          bubble.querySelectorAll('a[href]').forEach(function (link) {
            let url;
            try { url = new URL(link.href); } catch { return; }
            const match = url.hostname === 'radioller.com' && /^\/station\/([1-9]\d*)\/?$/.exec(url.pathname);
            if (!match || link.dataset.stationPlayerReady) return;
            const stationId = Number(match[1]);
            if (!Number.isSafeInteger(stationId)) return;
            link.dataset.stationPlayerReady = '1';

            const card = document.createElement('div');
            card.style.cssText = 'display:flex;align-items:center;gap:10px;margin:8px 0;padding:10px;border:1px solid var(--chat-border,#e5e7eb);border-radius:10px;background:var(--chat-surface,#fff);';
            const status = document.createElement('span');
            status.setAttribute('role', 'status');
            status.textContent = labels.loading;
            status.style.cssText = 'font-size:0.85em;color:var(--chat-muted,#6b7280);';
            card.append(status);
            link.insertAdjacentElement('afterend', card);

            fetch('/app/api/station.php?id=' + stationId, { cache: 'no-store' })
              .then(async function (response) {
                const station = await response.json();
                if (!response.ok) throw new Error(station.error || 'Station details are unavailable.');
                return station;
              })
              .then(function (station) {
                if (!Number.isSafeInteger(Number(station.id)) || Number(station.id) !== stationId) {
                  throw new Error('Station details did not match the requested station.');
                }
                if (station.browserPlayable !== true || typeof station.sr !== 'string' || !station.sr) {
                  throw new Error(labels.noStream);
                }
                let streamUrl;
                try { streamUrl = new URL(station.sr); } catch { throw new Error(labels.noStream); }
                if (streamUrl.protocol === 'http:') {
                  streamUrl.protocol = 'https:';
                }
                if (streamUrl.protocol !== 'https:') {
                  throw new Error(labels.noStream);
                }

                card.replaceChildren();
                if (typeof station.is === 'string' && station.is) {
                  const imageUrl = station.is.startsWith(String(stationId))
                    ? '/data/img/' + (stationId % 10) + '/' + encodeURIComponent(station.is)
                    : station.is;
                  try {
                    const parsedImage = new URL(imageUrl, location.origin);
                    if (['http:', 'https:'].includes(parsedImage.protocol)) {
                      const image = document.createElement('img');
                      image.src = parsedImage.href;
                      image.alt = '';
                      image.loading = 'lazy';
                      image.width = 44;
                      image.height = 44;
                      image.style.cssText = 'flex:0 0 44px;width:44px;height:44px;object-fit:cover;border-radius:7px;';
                      card.append(image);
                    }
                  } catch (error) {
                    console.error('Could not load station artwork URL', error);
                  }
                }

                const details = document.createElement('div');
                details.style.cssText = 'flex:1;min-width:0;';
                const name = document.createElement('div');
                name.textContent = typeof station.nm === 'string' ? station.nm : link.textContent.trim();
                name.style.cssText = 'font-weight:600;font-size:0.9em;';
                details.append(name);
                const meta = [station.cc, station.bt ? station.bt + ' kbps' : '', station.cd]
                  .filter(function (value) { return typeof value === 'string' && value; });
                if (meta.length) {
                  const info = document.createElement('div');
                  info.textContent = meta.join(' · ');
                  info.style.cssText = 'font-size:0.75em;color:var(--chat-muted,#6b7280);';
                  details.append(info);
                }

                const audio = document.createElement('audio');
                audio.preload = 'none';
                audio.src = streamUrl.href;
                audio.className = 'radioller-chat-audio';
                audio.addEventListener('play', function () {
                  document.querySelectorAll('audio.radioller-chat-audio').forEach(function (otherAudio) {
                    if (otherAudio !== audio) otherAudio.pause();
                  });
                });

                // Native controls overflow the narrow chat panel, so the card
                // uses a compact play/mute pair plus a volume slider that shrinks.
                const controls = document.createElement('div');
                controls.style.cssText = 'display:flex;align-items:center;gap:7px;margin-top:6px;';

                const playButton = document.createElement('button');
                playButton.type = 'button';
                playButton.style.cssText = 'flex:0 0 auto;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:none;border-radius:50%;cursor:pointer;background:var(--chat-primary,#ea580c);color:#fff;font-size:12px;line-height:1;padding:0;';
                playButton.textContent = '▶';
                playButton.setAttribute('aria-label', labels.play + ' ' + name.textContent);

                const state = document.createElement('span');
                state.style.cssText = 'display:block;width:100%;min-width:0;margin-top:3px;font-size:0.72em;line-height:1.3;color:var(--chat-muted,#6b7280);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';

                const muteButton = document.createElement('button');
                muteButton.type = 'button';
                muteButton.style.cssText = 'flex:0 0 auto;width:26px;height:26px;display:flex;align-items:center;justify-content:center;border:none;border-radius:50%;cursor:pointer;background:none;color:var(--chat-muted,#6b7280);font-size:13px;line-height:1;padding:0;';
                muteButton.textContent = '🔊';
                muteButton.setAttribute('aria-label', labels.mute);

                const volume = document.createElement('input');
                volume.type = 'range';
                volume.min = '0';
                volume.max = '1';
                volume.step = '0.05';
                volume.value = '1';
                volume.setAttribute('aria-label', labels.volume);
                volume.style.cssText = 'flex:0 1 64px;min-width:36px;height:16px;margin:0;accent-color:var(--chat-primary,#ea580c);cursor:pointer;';

                function syncState() {
                  const playing = !audio.paused;
                  playButton.textContent = playing ? '❚❚' : '▶';
                  playButton.setAttribute('aria-label', (playing ? labels.pause : labels.play) + ' ' + name.textContent);
                  state.textContent = playing ? labels.live : '';
                  state.hidden = !playing;
                  state.style.display = playing ? 'block' : 'none';
                }
                playButton.addEventListener('click', function () {
                  if (audio.paused) {
                    state.textContent = labels.buffering;
                    state.hidden = false;
                    state.style.display = 'block';
                    audio.play().catch(function () {
                      state.textContent = labels.noStream;
                      state.hidden = false;
                      state.style.display = 'block';
                    });
                  } else {
                    audio.pause();
                  }
                });
                muteButton.addEventListener('click', function () {
                  audio.muted = !audio.muted;
                  muteButton.textContent = audio.muted ? '🔇' : '🔊';
                  muteButton.setAttribute('aria-label', audio.muted ? labels.unmute : labels.mute);
                });
                volume.addEventListener('input', function () {
                  audio.volume = Number(volume.value);
                  if (audio.muted && Number(volume.value) > 0) {
                    audio.muted = false;
                    muteButton.textContent = '🔊';
                    muteButton.setAttribute('aria-label', labels.mute);
                  }
                });
                audio.addEventListener('playing', syncState);
                audio.addEventListener('pause', syncState);
                audio.addEventListener('waiting', function () {
                  state.textContent = labels.buffering;
                  state.hidden = false;
                  state.style.display = 'block';
                });
                syncState();

                controls.append(playButton, muteButton, volume);
                details.append(controls, state, audio);
                card.append(details);
              })
              .catch(function (error) {
                status.textContent = error instanceof Error && error.message
                  ? error.message
                  : labels.unavailable;
                status.style.color = '#b91c1c';
                const appLink = document.createElement('a');
                appLink.href = '/app/';
                appLink.textContent = labels.openApp;
                appLink.style.cssText = 'font-size:0.85em;color:var(--chat-primary,#ea580c);';
                card.append(appLink);
              });
          });
        },
        payload: {
          project: '0ea7a32a-f3d8-435c-a5b0-23634ce7be99',
          key: 'pub_9d86a29b3367af2051b5e34a2adc6abe',
          lang: (navigator.language || 'en').slice(0, 2),
